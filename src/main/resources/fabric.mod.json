{
  "schemaVersion": 1,
  "id": "coa-display",
  "version": "${version}",
  "name": "Coa display",
  "description": "Displays total coins in your crown of avarice!",
  "authors": [
    "ab2891"
  ],
  "contact": {
    "sources": "https://github.com/ab2891/coa-display",
    "issues": "https://github.com/ab2891/coa-display/issues"
  },
  "license": "CC0-1.0",
  "icon": "assets/coa-display/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.coadisplay.CoaDisplay"
    ],
    "client": [
      "com.ab2891.coadisplay.CoaDisplayClient"
    ],
    "modmenu": [
      "com.ab2891.coadisplay.compat.ModMenuCompat"
    ]
  },
  "mixins": [
    {
      "config": "coa-display.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "26.1.2",
    "java": ">=25",
    "fabric-api": ">=0.152.1",
    "yet_another_config_lib_v3": ">=3.9.4"
  },
  "suggests": {
    "modmenu": ">=18.0.0-beta.1"
  }
}
